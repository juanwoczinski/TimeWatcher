timewatcher.32-193-139-223.sslip.io {
	route {
		# Agent ingestion — bearer-token endpoints only. Restricting to /v1/*
		# closes the previous /ingest/* proxy that exposed the dashboard API
		# without authentication.
		handle /ingest/v1/* {
			uri strip_prefix /ingest
			reverse_proxy 127.0.0.1:5610
		}

		# Platform API — authentication is enforced by the app (session cookie),
		# not by the proxy. No basic-auth, no injected user header.
		handle /platform-api/* {
			uri strip_prefix /platform-api
			reverse_proxy 127.0.0.1:5610
		}

		# Dashboard SPA — serves the login screen for anonymous visitors.
		handle {
			reverse_proxy 127.0.0.1:3110
		}
	}
}
