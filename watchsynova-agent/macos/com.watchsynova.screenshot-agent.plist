<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.timewatcher.app</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>-a</string>
    <string>__APP_PATH__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__LOG_PATH__/screenshot-agent.log</string>
  <key>StandardErrorPath</key><string>__LOG_PATH__/screenshot-agent.error.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
