<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="TimeWatcher" Manufacturer="Synova Tecnologia" Version="0.2.0" UpgradeCode="A4F61A44-49FB-4B47-9D74-78628318C167" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do TimeWatcher já está instalada." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="TimeWatcher">
        <Component Id="AgentFiles" Guid="A57E86E2-5C66-43F3-9811-17A4AD489342">
          <File Id="AgentScript" Source="TimeWatcherAgent.ps1" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Main" Title="TimeWatcher Agent"><ComponentRef Id="AgentFiles" /></Feature>
  </Package>
</Wix>
